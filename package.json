{
  "name": "see-dsh-novel",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@11.21.0",
  "description": "以 DSH 原生机制实现长篇写作流水线",
  "scripts": {
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "node --import tsx --test packages/see-dsh-novel/test/*.test.mjs scripts/*.test.mjs",
    "verify-agent-note-tree": "node .agents/skills/write-agent-notes/scripts/verify-agent-note-tree.ts --root .agents/notes",
    "verify-agent-note-format": "node .agents/skills/write-agent-notes/scripts/verify-agent-note-format.ts --root .agents/notes",
    "verify-archived": "node .agents/skills/write-agent-notes/scripts/verify-archived-agent-notes.ts --root .agents/notes",
    "verify-note-lifecycle": "node .agents/skills/write-agent-notes/scripts/verify-agent-note-lifecycle.ts --root .agents/notes",
    "verify-notes": "npm run verify-agent-note-tree && npm run verify-agent-note-format && npm run verify-archived && npm run verify-note-lifecycle",
    "check-capabilities": "node scripts/check-capabilities.mjs",
    "verify": "pnpm run typecheck && pnpm run build && pnpm run check-package && pnpm run check-boundary && pnpm run verify-notes && pnpm run check-capabilities && pnpm run test",
    "check-package": "node --import tsx scripts/check-package.mjs",
    "check-boundary": "node --import tsx scripts/check-boundary.mjs"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-api-session-controller": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-resources": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-session": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.2-rc.1",
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.31",
    "@types/react-test-renderer": "^18.3.1",
    "esbuild": "^0.28.2",
    "react": "18.3.1",
    "react-test-renderer": "18.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3",
    "yaml": "^2.9.1"
  }
}
