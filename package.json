{
  "name": "see-dsh-novel",
  "private": true,
  "version": "0.0.0",
  "description": "以 DSH 原生机制实现长篇写作流水线",
  "scripts": {
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "node --import tsx --test packages/see-dsh-novel/test/*.test.mjs",
    "verify-notes": "tsx .agents/skills/write-agent-notes/scripts/verify-agent-note-tree.ts --root .agents/notes && tsx .agents/skills/write-agent-notes/scripts/verify-agent-note-format.ts --root .agents/notes && tsx .agents/skills/write-agent-notes/scripts/verify-archived-agent-notes.ts --root .agents/notes",
    "check-capabilities": "node scripts/check-capabilities.mjs",
    "verify": "pnpm run typecheck && pnpm run build && pnpm run verify-notes && pnpm run check-capabilities && pnpm run test"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-api-session-controller": "0.2.1-rc.5",
    "@deepseek-ai/dsh-client-resources": "0.2.1-rc.5",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.1-rc.5",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.1-rc.5",
    "@deepseek-ai/dsh-client-ui-session": "0.2.1-rc.5",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-rc.5",
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.31",
    "@types/react-test-renderer": "^18.3.1",
    "esbuild": "^0.28.2",
    "react": "18.3.1",
    "react-test-renderer": "18.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3",
    "yaml": "^2.9.1"
  }
}
