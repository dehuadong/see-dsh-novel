{
  "name": "see-dsh-novel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "以 DSH 原生机制实现的长篇写作流水线：story_next 工具与作品面板",
  "exports": {
    ".": "./lib/index.js",
    "./agent": "./lib/agent.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "skills",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "node scripts/bundle.mjs",
    "typecheck": "tsc -p ."
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
